NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
AI_GATEWAY_API_KEY=...
AI_GATEWAY_MODEL=openai/gpt-5-mini
# Dev-mode telemetry for block-suggestion picker (PR1). Default OFF in every
# environment. Set to "true" in .env.local for local development, and in
# the Vercel project env vars for the alpha preview. Do NOT set for
# production (main). The flag gates a console.info log line that future
# PRs will use to auto-tune block-suggestion duration caps; it has no
# user-facing effect.
# SYLLABI_DEV_TELEMETRY=true
# Optional. When set to a comma-separated list of emails, deployed previews
# only allow sign-in for those accounts. Leave unset for local development.
# NEXT_PUBLIC_ACCESS_GATE_EMAILS=you@example.com,friend@example.com
#
# NOTE: this is a convenience filter in the browser, not a security boundary.
# Anyone can read it in the client bundle and it does not stop API access.
# Real protection comes from Supabase row-level security plus invite-only signup.
