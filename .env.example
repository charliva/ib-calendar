NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
AI_GATEWAY_API_KEY=...
AI_GATEWAY_MODEL=openai/gpt-5-mini
# Optional. When set to a comma-separated list of emails, deployed previews
# only allow sign-in for those accounts. Leave unset for local development.
# NEXT_PUBLIC_ACCESS_GATE_EMAILS=tjallingvanabbema@gmail.com
