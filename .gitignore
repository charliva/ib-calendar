# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local CLI/tool scratch state (leaks project refs, pooler URLs, local certs)
/supabase/.temp/
/.openai/

# typescript
next-env.d.ts
*.tsbuildinfo

# build output and tool state
/dist/
/.wrangler/
/outputs/
/work/
/.unlazy/

# OneDrive/iCloud sync conflict copies ("index 2.ts") are not ignored here on
# purpose: a pattern broad enough to catch them would also swallow legitimate
# names like "Phase 2.md". `npm run doctor` finds and removes them instead.
