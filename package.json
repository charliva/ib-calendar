  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "npm run doctor && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-popover": "1.1.23",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "ai": "7.0.42",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "idb": "8.0.3",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@cloudflare/workers-types": "5.20260730.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "supabase": "2.110.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vinext": "1.0.0-beta.10",
    "vite": "8.2.0",
    "wrangler": "4.116.0"
  },
  "type": "module"
}
